{
  "name": "tg-botsx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "传声筒：中文 Telegram 双向客服机器人，同一套代码跑在 Cloudflare Workers 和自有服务器上",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev:worker": "wrangler dev",
    "start": "node src/runtime/node.ts",
    "deploy": "wrangler deploy",
    "e2e": "node test/e2e/run.ts"
  },
  "cloudflare": {
    "bindings": {
      "BOT_TOKEN": {
        "description": "机器人的 Token。在 Telegram 打开 [@BotFather](https://t.me/BotFather)，发送 `/newbot` 按提示创建后获得。"
      }
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@grammyjs/types": "^5.0.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
