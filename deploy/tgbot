#!/usr/bin/env bash
# 传声筒管理命令。不带参数显示菜单。
# 一台服务器上的所有机器人跑在同一个容器里，每个机器人一个数据库文件，数据互不相通。
#   tgbot add            新增机器人，可以一次粘贴多个 Token
#   tgbot shop status    管理名叫 shop 的机器人；不写名字就是默认机器人
set -euo pipefail

DIR="${TGBOTSX_DIR:-/opt/tg-botsx}"
NAME=""
INSTALL_URL="https://raw.githubusercontent.com/${TGBOTSX_REPO:-dodo258/tg-botsx}/${TGBOTSX_BRANCH:-main}/deploy/install.sh"

die() { printf '错误：%s\n' "$*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || exec sudo -E "$0" "$@"
[ -f "$DIR/docker-compose.yml" ] || die "在 $DIR 没找到安装。先运行安装脚本。"
compose() { (cd "$DIR" && docker compose "$@"); }
run_node() { compose exec -T bot node --disable-warning=ExperimentalWarning dist/runtime/node.js "$@"; }

bot_running() {
  compose ps --status running --services 2>/dev/null | grep -qx bot
}

need_running() {
  bot_running || die "机器人没在运行。先运行 tgbot restart。"
}

known_bot() {
  run_node list </dev/null | cut -f1 | grep -qxF "$1"
}

# 不用 docker restart：它不会读改过的 .env，改了代理或端口不生效
cmd_restart() {
  compose up -d --force-recreate bot
}

cmd_status() {
  if [ -n "$NAME" ]; then
    run_node list </dev/null | grep -F "$NAME	" || true
    printf '\n最近日志：\n'
    compose logs --tail=200 --no-log-prefix bot | grep -F "[$NAME]" | tail -n 10 || true
    return
  fi
  compose ps
  printf '\n所有机器人：\n'
  if bot_running; then run_node list </dev/null; fi
  printf '\n最近日志：\n'
  compose logs --tail=10 bot
}

cmd_logs() {
  if [ -n "$NAME" ]; then
    compose logs -f --tail=50 --no-log-prefix bot | grep --line-buffered -F "[$NAME]"
  else
    compose logs -f --tail=50 bot
  fi
}

cmd_backup() {
  backup_bot "$NAME"
}

# 参数是机器人的名字，空字符串是默认机器人
backup_bot() {
  bot_running || die "机器人没在运行，没法在线备份。先 tgbot restart。"
  local bot="$1" name target
  name="relay${bot:+-$bot}-$(date +%Y%m%d-%H%M%S).db"
  target="$DIR/backups"
  mkdir -p "$target"
  chmod 700 "$target"
  # 用数据库自带的在线备份，不用停机，也不会拷到写了一半的文件
  run_node backup "/data/$name" ${bot:+"$bot"} </dev/null
  # 容器根目录只读、/tmp 是内存盘，docker cp 取不到，所以写进数据卷后用 cat 取出
  # 子 shell 限定 umask，不影响后面调用的安装脚本
  ( umask 077; compose exec -T bot cat "/data/$name" </dev/null > "$target/$name" )
  compose exec -T bot rm -f "/data/$name" </dev/null
  [ -s "$target/$name" ] || die "备份文件是空的，请检查机器人是否在运行。"
  # 备份里有全部聊天内容。CI 实测只靠 umask 得到过 666，所以写完再显式收紧
  chmod 600 "$target/$name"
  printf '已备份到 %s\n' "$target/$name"
}

BACKUP_FAILED=""

# 一个机器人备份失败（比如数据库坏了）不能挡住其他的，但要说出来
backup_all_if_possible() {
  if ! bot_running; then
    printf '机器人没在运行，跳过这次备份。\n'
    return
  fi
  local name bot
  while IFS=$'\t' read -r name _; do
    if [ -z "$name" ]; then continue; fi
    bot="$name"
    if [ "$name" = "默认" ]; then bot=""; fi
    if ! ( backup_bot "$bot" ) </dev/null; then
      BACKUP_FAILED="$BACKUP_FAILED $name"
    fi
  done < <(run_node list </dev/null)
  if [ -n "$BACKUP_FAILED" ]; then printf '注意：这些机器人没备份成功：%s\n' "$BACKUP_FAILED" >&2; fi
}

cmd_backup_all() {
  backup_all_if_possible
  [ -z "$BACKUP_FAILED" ]
}

# 恢复前尽量备份；机器人挂了也不能拦住修复
backup_if_possible() {
  if bot_running; then
    cmd_backup
  else
    printf '机器人没在运行，跳过这次备份。\n'
  fi
}

cmd_restore() {
  local source="${1:-}"
  [ -n "$source" ] || die "用法：tgbot restore 备份文件"
  [ -f "$source" ] || die "找不到 $source"
  printf '会用这个备份覆盖%s的数据（覆盖前会先备份一次）。恢复时所有机器人会停几秒：%s\n' "${NAME:-默认机器人}" "$source"
  local answer
  read -r -p "确认恢复？输入「恢复」继续: " answer
  [ "$answer" = "恢复" ] || { printf '已取消。\n'; return; }
  backup_if_possible
  compose stop bot
  # 容器停了也能往数据卷里写：临时起一个只挂卷的容器
  local db_dir="/data${NAME:+/bots/$NAME}"
  docker run --rm -e DB_DIR="$db_dir" -v "$(basename "$DIR")_data:/data" -v "$(realpath "$source"):/restore.db:ro" node:26-alpine \
    sh -c 'rm -f "$DB_DIR/relay.db-wal" "$DB_DIR/relay.db-shm" && cp /restore.db "$DB_DIR/relay.db" && chown node:node "$DB_DIR/relay.db"'
  compose start bot
  printf '已恢复。\n'
}

cmd_update() {
  printf '更新前先备份数据…\n'
  backup_all_if_possible
  # 环境变量里的 Token 会盖过 .env
  unset BOT_TOKEN BOT_TOKENS TELEGRAM_API_BASE
  if [ -n "${TGBOTSX_SOURCE:-}" ]; then
    TGBOTSX_YES=1 TGBOTSX_DIR="$DIR" bash "$TGBOTSX_SOURCE/deploy/install.sh"
    return
  fi
  local installer
  installer="$(mktemp)"
  curl -fsSL --max-time 60 "$INSTALL_URL" -o "$installer" || die "下载安装脚本失败。"
  TGBOTSX_YES=1 TGBOTSX_DIR="$DIR" bash "$installer"
  rm -f "$installer"
}

# 不写名字时可以一次粘贴多个 Token，一行一个，空行结束。每个机器人用自己的用户名起名
cmd_add() {
  local name="${1:-}" user="${2:-}" token="${BOT_TOKEN:-}" failed=0
  need_running
  if [ -n "$token" ]; then
    printf '%s\n' "$token" | run_node add ${name:+"$name"} ${user:+"$user"}
    return
  fi
  printf '在 @BotFather 发 /newbot 新建机器人。粘贴 Token，可以一次粘贴多个，一行一个，粘贴完再按一次回车：\n'
  while IFS= read -r -s token; do
    [ -n "$token" ] || break
    if ! printf '%s\n' "$token" | run_node add ${name:+"$name"} ${user:+"$user"}; then failed=1; fi
    name=""
  done
  printf '\n把机器人的用户名发给要用的人，对方私聊机器人，点「成为管理员」就好了。\n'
  return "$failed"
}

cmd_token() {
  local token
  read -r -s -p "粘贴新的 Bot Token（输入时不显示）: " token
  printf '\n'
  [ -n "$token" ] || die "没有输入。"
  if [ -n "$NAME" ]; then
    printf '%s\n' "$token" | run_node token "$NAME"
    return
  fi
  if bot_running; then
    case "$(printf '%s\n' "$token" | run_node token-check)" in
      used) die "这个 Token 已经给别的机器人用了。同一个 Token 跑两份，两边都收不到消息。" ;;
      invalid) die "Telegram 不认这个 Token，没有更换。到 @BotFather 发 /token 核对。" ;;
      unreachable) printf '现在连不上 Telegram，没法校验这个 Token，先换上。\n' ;;
      *) ;;
    esac
  fi
  local updated
  umask 077
  updated="$(mktemp)"
  grep -v '^BOT_TOKEN=' "$DIR/.env" > "$updated" || true
  printf 'BOT_TOKEN=%s\n' "$token" >> "$updated"
  cat "$updated" > "$DIR/.env"
  rm -f "$updated"
  chmod 600 "$DIR/.env"
  compose up -d
  printf '已更新并重启。\n'
}

cmd_uninstall() {
  if [ -n "$NAME" ]; then
    printf '会删除机器人 %s 和它的聊天数据，其他机器人不受影响。删除前会备份。\n' "$NAME"
    local confirm_bot
    read -r -p "确认删除？输入「删除」继续: " confirm_bot
    [ "$confirm_bot" = "删除" ] || { printf '已取消。\n'; return; }
    # 数据库坏了备份不了，这时也要能删掉它
    if ! ( cmd_backup ); then printf '这个机器人备份不了，直接删除。\n'; fi
    run_node remove "$NAME" </dev/null
    return
  fi
  printf '会停止并删除整个传声筒，包括服务器上的所有机器人：\n'
  if bot_running; then run_node list </dev/null | cut -f1,2; fi
  local answer confirm
  read -r -p "同时删除所有聊天数据吗？要删请输入「删除数据」，直接回车保留: " answer
  read -r -p "确认卸载？输入「卸载」继续: " confirm
  [ "$confirm" = "卸载" ] || { printf '已取消。\n'; return; }
  if [ "$answer" = "删除数据" ]; then
    if bot_running; then
      backup_all_if_possible
      printf '已先备份到 %s/backups。\n' "$DIR"
    else
      printf '机器人没在运行，没法备份，删除后数据找不回来。\n'
      read -r -p "确认不备份直接删除？输入「不备份」继续: " confirm
      [ "$confirm" = "不备份" ] || { printf '已取消。先运行 tgbot restart，再卸载就能备份。\n'; return; }
    fi
    compose down -v
    printf '数据已删除。Token 还在 %s/.env，确认不需要后自己删掉 %s 这个目录。\n' "$DIR" "$DIR"
    rm -f /usr/local/bin/tgbot
    rm -rf "$DIR/src" "$DIR/package.json" "$DIR/Dockerfile" "$DIR/.dockerignore" "$DIR/.env.example" "$DIR/docker-compose.yml" "$DIR/docker-compose.web.yml" "$DIR/docker-compose.caddy.yml" "$DIR/Caddyfile"
  else
    compose down
    rm -f /usr/local/bin/tgbot
    printf '程序已停止。数据保留在 Docker 数据卷，配置在 %s，重新安装会接着用。\n' "$DIR"
  fi
}

web_enabled() {
  grep -q '^COMPOSE_FILE=.*\(web\|caddy\)' "$DIR/.env"
}

set_env() {
  local updated
  updated="$(umask 077; mktemp)"
  grep -v "^$1=" "$DIR/.env" > "$updated" || true
  if [ -n "${2:-}" ]; then printf '%s=%s\n' "$1" "$2" >> "$updated"; fi
  cat "$updated" > "$DIR/.env"
  rm -f "$updated"
  chmod 600 "$DIR/.env"
}

cmd_web() {
  case "${1:-}" in
    on) cmd_web_on "${2:-}"; return ;;
    off) cmd_web_off; return ;;
    "") ;;
    *) die "用法：tgbot web [on [域名] | off]" ;;
  esac
  if ! web_enabled; then
    printf '网页管理没有开。要开的话运行 tgbot web on，用自己的域名就运行 tgbot web on 域名。\n'
    return
  fi
  local port url domain ip
  port="$(sed -n 's/^WEB_PORT=//p' "$DIR/.env" | head -n 1)"
  url="$(sed -n 's/^WEB_URL=//p' "$DIR/.env" | head -n 1)"
  domain="$(sed -n 's/^WEB_DOMAIN=//p' "$DIR/.env" | head -n 1)"
  if [ -n "$domain" ]; then url="https://$domain"; fi
  if [ -n "$domain" ]; then
    local expiry
    expiry="$(cert_expiry "$domain" || true)"
    printf '地址：%s\n证书：Let'"'"'s Encrypt，%s，到期前会自动续。\n' "$url" "${expiry:+到期时间 $expiry}"
    return
  fi
  if [ -n "$url" ]; then
    printf '地址：%s\n' "$url"
    return
  fi
  ip="$(curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null || hostname -I | cut -d' ' -f1)"
  printf '地址：https://%s:%s\n' "$ip" "$port"
  printf '用的是自签名证书，第一次打开浏览器会提示不安全，点「高级」再继续就行，连接是加密的。\n'
  printf '打不开的话，到云服务商的防火墙（安全组）放行 TCP %s 端口。\n' "$port"
}

port_taken() {
  ss -H -ltn "sport = :$1" 2>/dev/null | grep -q .
}

# 域名有没有解析。解析到别的 IP 不算失败：可能是放在 Cloudflare 这类代理后面，能不能申请到证书以实际结果为准
check_domain() {
  local domain="$1" resolved ip
  resolved="$(getent ahosts "$domain" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ' || true)"
  if [ -z "$resolved" ]; then
    printf '域名 %s 还没有解析。到域名服务商那里加一条 A 记录，指向这台服务器。\n' "$domain"
    return 1
  fi
  ip="$(curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)"
  case " $resolved " in
    *" $ip "*) ;;
    *) printf '提醒：%s 解析到 %s，这台服务器的 IP 是 %s。如果不是用了代理，证书会申请失败。\n' "$domain" "$resolved" "${ip:-未知}" ;;
  esac
}

# 用真实的证书校验连本机，确认证书已经签下来，不依赖服务器能不能访问自己的公网地址
cert_ready() {
  curl -fsS --max-time 5 --resolve "$1:443:127.0.0.1" -o /dev/null "https://$1/" 2>/dev/null
}

# 证书的到期时间，用来告诉人续期在正常工作
cert_expiry() {
  curl -sSv --max-time 5 --resolve "$1:443:127.0.0.1" -o /dev/null "https://$1/" 2>&1 | sed -n 's/^\*  *expire date: //p' | head -n 1
}

# 申请不到证书时退回到随机端口加自签名证书：网页要能打开，不能让人卡在这一步
fall_back_to_port() {
  printf '\n先用没有域名的方式把网页开起来。问题解决后运行 tgbot web on %s 再试一次。\n' "$1"
  cmd_web_on ""
}

# 带域名：Caddy 自动申请 Let's Encrypt 证书，到期前自动续，不用人管。不带域名：开一个随机端口，用程序自签的证书
cmd_web_on() {
  local domain="${1:-}"
  if [ -n "$domain" ]; then
    [[ "$domain" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?\.[A-Za-z]{2,}$ ]] || die "域名不对，写成 bot.example.com 这样。"
    local p
    for p in 80 443; do
      if port_taken "$p" && ! compose ps --status running --services 2>/dev/null | grep -qx caddy; then
        printf '%s 端口被别的程序占着，申请证书需要它。可以停掉那个程序，或者把网页放在 Cloudflare 代理、自己的 nginx 后面（见 README）。\n' "$p"
        fall_back_to_port "$domain"
        return
      fi
    done
    if ! check_domain "$domain"; then
      fall_back_to_port "$domain"
      return
    fi
    set_env WEB_DOMAIN "$domain"
    set_env WEB_URL ""
    set_env COMPOSE_FILE "docker-compose.yml:docker-compose.caddy.yml"
  else
    # 显式传的端口要写回 .env，否则下次更新又变回去
    if [ -n "${WEB_PORT:-}" ]; then
      set_env WEB_PORT "$WEB_PORT"
    elif ! grep -q '^WEB_PORT=' "$DIR/.env"; then
      local port
      port="$(( ( $(od -An -N2 -tu2 /dev/urandom) % 40000 ) + 20000 ))"
      if port_taken "$port"; then die "$port 端口被占用了，再运行一次换一个。"; fi
      set_env WEB_PORT "$port"
    fi
    if [ -n "${WEB_URL:-}" ]; then set_env WEB_URL "$WEB_URL"; fi
    if [ -n "${WEB_IP_HEADER:-}" ]; then set_env WEB_IP_HEADER "$WEB_IP_HEADER"; fi
    set_env WEB_DOMAIN ""
    set_env COMPOSE_FILE "docker-compose.yml:docker-compose.web.yml"
  fi
  if ! compose up -d --remove-orphans; then
    # 比如 Caddy 镜像拉不下来、80 端口绑定失败。配置不能留在这种打不开的状态
    if [ -z "$domain" ]; then die "启动失败，看上面的报错。"; fi
    printf '\n域名方式启动失败，看上面的报错。\n'
    fall_back_to_port "$domain"
    return
  fi
  local waited=0
  until bot_running && compose exec -T bot true </dev/null 2>/dev/null; do
    sleep 1
    waited=$((waited + 1))
    [ "$waited" -lt 30 ] || die "容器没有起来，运行 tgbot logs 看原因。"
  done
  ensure_web_login
  if [ -n "$domain" ]; then
    printf '正在申请证书，通常不到一分钟…\n'
    waited=0
    until cert_ready "$domain"; do
      sleep 3
      waited=$((waited + 3))
      if [ "$waited" -ge 120 ]; then
        printf '\n两分钟内没申请到证书。Caddy 最后的日志：\n'
        compose logs --tail=8 --no-log-prefix caddy 2>/dev/null | cut -c1-300 || true
        printf '\n最常见的原因：云服务商的防火墙没放行 80 和 443 端口；域名解析还没生效，或者解析到了别的 IP。\n'
        fall_back_to_port "$domain"
        return
      fi
    done
    printf '证书申请好了，到期前会自动续。\n'
  fi
  cmd_web
  show_first_password
}

WEB_FIRST_PASSWORD=""

# 第一次开随机生成账号密码，只显示这一次。已有账号时不动
ensure_web_login() {
  if compose exec -T bot test -f /data/web/auth.json </dev/null; then
    return 0
  fi
  WEB_FIRST_PASSWORD="$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')"
  printf 'admin\n%s\n' "$WEB_FIRST_PASSWORD" | run_node web-auth >/dev/null
}

show_first_password() {
  if [ -n "$WEB_FIRST_PASSWORD" ]; then
    printf '账号：admin\n密码：%s\n密码只显示这一次。要改成自己的，运行 tgbot web-password，或登录后在网页里改。\n' "$WEB_FIRST_PASSWORD"
  else
    printf '登录用你之前设的账号密码，忘了运行 tgbot web-password 重设。\n'
  fi
}

cmd_web_off() {
  # 明确写上只用基础配置：只删掉的话，安装脚本会当成旧版本，更新时又把端口打开
  set_env COMPOSE_FILE "docker-compose.yml"
  compose up -d --remove-orphans
  printf '网页管理已关闭，对外端口也关了。机器人照常运行。账号密码还留着，再开不用重设。\n'
}

# 账号密码只存哈希。重设后已登录的设备立刻失效，登录锁定也解开
cmd_web_password() {
  need_running
  local user password
  read -r -p "账号: " user
  read -r -s -p "密码（至少 8 位，输入时不显示）: " password
  printf '\n'
  printf '%s\n%s\n' "$user" "$password" | run_node web-auth
}

menu() {
  printf '传声筒 管理菜单%s\n' "${NAME:+（$NAME）}"
  cat <<'MENU'
  1) 查看状态
  2) 查看实时日志
  3) 重启全部
  4) 更新到最新版（会先备份）
  5) 备份数据
  6) 恢复数据
  7) 重新绑定管理员
  8) 更换 Bot Token
  9) 卸载
  a) 新增机器人
  l) 查看所有机器人
  w) 网页管理地址
  0) 退出
MENU
  local choice file
  read -r -p "选择: " choice
  case "$choice" in
    1) cmd_status ;;
    2) cmd_logs ;;
    3) cmd_restart ;;
    4) cmd_update ;;
    5) if [ -n "$NAME" ]; then cmd_backup; else cmd_backup_all; fi ;;
    6) read -r -p "备份文件路径: " file; cmd_restore "$file" ;;
    7) run_node claim ${NAME:+"$NAME"} </dev/null ;;
    8) cmd_token ;;
    9) cmd_uninstall ;;
    a) cmd_add ;;
    l) run_node list </dev/null ;;
    w) cmd_web ;;
    *) ;;
  esac
}

usage() {
  cat <<'USAGE'
用法：
  tgbot add [名字 [对方的用户名]]   新增机器人，不写名字可以一次粘贴多个 Token
  tgbot list                       查看所有机器人
  tgbot web                        网页管理的地址
  tgbot web on [域名]              开网页管理，带域名就自动申请并续期 Let's Encrypt 证书
  tgbot web off                    关网页管理，对外端口也关掉
  tgbot web-password               设置网页管理的账号和密码
  tgbot update                     更新（所有机器人一起）
  tgbot restart                    重启（所有机器人一起），改了 .env 也用它
  tgbot backup                     备份所有机器人的聊天数据
  tgbot [名字] [status|logs|backup|restore 文件|claim|token|uninstall]
不写名字就是默认机器人。
USAGE
}

is_command() {
  case "$1" in
    add|list|web|web-password|update|restart|status|logs|backup|restore|claim|token|uninstall) return 0 ;;
    *) return 1 ;;
  esac
}

# 第一个参数不是命令就是机器人的名字
if [ -n "${1:-}" ] && ! is_command "$1"; then
  if ! [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,39}$ ]]; then usage; exit 1; fi
  need_running
  known_bot "$1" || die "没有叫 $1 的机器人。运行 tgbot list 查看已有的。"
  NAME="$1"
  shift
fi

case "${1:-}" in
  "") menu ;;
  add) cmd_add "${2:-}" "${3:-}" ;;
  list) need_running; run_node list </dev/null ;;
  web) cmd_web "${2:-}" "${3:-}" ;;
  web-password) cmd_web_password ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  restart) cmd_restart ;;
  update) cmd_update ;;
  backup) if [ -n "$NAME" ]; then cmd_backup; else cmd_backup_all; fi ;;
  restore) cmd_restore "${2:-}" ;;
  claim) need_running; run_node claim ${NAME:+"$NAME"} </dev/null ;;
  token) cmd_token ;;
  uninstall) cmd_uninstall ;;
  *) usage ;;
esac
