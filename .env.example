# 必填：在 Telegram 的 @BotFather 发 /newbot 得到
BOT_TOKEN=

# 选填：服务器连不上 Telegram 时二选一
# 1) 用代理
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7890
# 2) 用自建的 Bot API 反向代理
# TELEGRAM_API_BASE=https://你的反代域名

# 选填：数据目录（Docker 部署不用改）
# DATA_DIR=./data

# 选填：网页管理。用 tgbot web on 开，下面这些一般不用手改
# WEB_PORT=2053
# 放在 Cloudflare 或自己的反代后面时：对外地址，以及带真实 IP 的请求头
# WEB_URL=https://bot.example.com
# WEB_IP_HEADER=cf-connecting-ip
